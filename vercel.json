{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "app/dist",
  "installCommand": "cd app && npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/_app" },
    { "source": "/splash", "destination": "/_app" },
    { "source": "/onboarding", "destination": "/_app" },
    { "source": "/terms", "destination": "/_app" },
    { "source": "/home", "destination": "/_app" },
    { "source": "/services", "destination": "/_app" },
    { "source": "/services/:id", "destination": "/_app" },
    { "source": "/bookings", "destination": "/_app" },
    { "source": "/pricing", "destination": "/_app" },
    { "source": "/profile", "destination": "/_app" }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.html",
      "destination": "/$1",
      "permanent": true
    }
  ]
}
